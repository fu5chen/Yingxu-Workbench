# Provider credentials belong in confiykey.json (copy confiykey.example.json).
# npm run setup generates these two secrets once. Keep them across restarts.
STUDIO_RUNNER_TOKEN=
JOB_ENCRYPTION_KEY=
# Optional executable for video thumbnails; otherwise ffmpeg is found in PATH.
FFMPEG_PATH=
# Optional extra local copies of generated originals; disabled to save disk.
STUDIO_LOCAL_ARCHIVE=false
# Free disk reserve (MiB). Loaded by npm run start:local.
STUDIO_SUBMIT_RESERVE_MIB=2560
STUDIO_MEDIA_RESERVE_MIB=1536
